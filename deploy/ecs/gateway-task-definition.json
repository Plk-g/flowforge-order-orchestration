{
  "family": "flowforge-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "gateway",
      "image": "ACCOUNT.dkr.ecr.REGION.amazonaws.com/flowforge-gateway:latest",
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "ORDER_SERVICE_URI", "value": "http://order-service:8081" }
      ]
    }
  ]
}
